{
  "expo": {
    "name": "Waruung",
    "slug": "waruung",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "waruung",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.waruung.app",
      "config": {
        "googleMapsApiKey": "AIzaSyCQOfitYRU7iAHMRaj0dwcrI8-UQIiFPWI"
      }
    },
    "android": {
      "package": "com.waruung.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#40a3ea"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCQOfitYRU7iAHMRaj0dwcrI8-UQIiFPWI"
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Waruung memerlukan akses lokasi untuk menentukan titik jemput dan menampilkan posisi kamu di peta.",
          "locationAlwaysAndWhenInUsePermission": "Waruung memerlukan akses lokasi untuk mencari driver terdekat dan menampilkan posisi kamu di peta."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/app-icon.png",
          "color": "#40a3ea",
          "defaultChannel": "default",
          "sounds": [
            "./assets/sounds/notification.mp3"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "888d8310-6b3f-470a-9057-5baa748aca11"
      }
    },
    "owner": "amirku"
  }
}